---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang).about;
---

<section id="sobre-mi" class="wrap section" aria-labelledby="sobre-mi-titulo">
  <div class="section-grid">
    <h2 id="sobre-mi-titulo" class="section-title">{a.title}</h2>

    <div class="about">
      <div class="text">
        {a.paragraphs.map((text) => <p>{text}</p>)}
      </div>
      <img
        src="/Foto-Matus-1.webp"
        alt={a.photoAlt}
        width="420"
        height="420"
        loading="lazy"
        decoding="async"
        class="photo"
      />
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 36rem) 14rem;
      justify-content: space-between;
      align-items: start;
    }
  }
  .text {
    display: grid;
    gap: 1.25rem;
  }
  .text p:first-child {
    font-size: var(--fs-h3);
    line-height: 1.45;
  }
  .text p + p {
    color: var(--muted);
  }
  .photo {
    width: 9rem;
    height: auto;
    border-radius: 6px;
  }
  @media (min-width: 64rem) {
    .photo {
      width: 100%;
    }
  }
</style>
