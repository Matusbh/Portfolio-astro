---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).stack;
---

<section id="stack" class="wrap section" aria-labelledby="stack-titulo">
  <div class="section-grid">
    <h2 id="stack-titulo" class="section-title">{s.title}</h2>

    <dl class="groups">
      {
        s.groups.map((g) => (
          <div class="group">
            <dt class="muted">{g.name}</dt>
            <dd>{g.items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .groups {
    max-width: 48rem;
    border-top: 1px solid var(--line);
  }
  .group {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .group {
      grid-template-columns: 11rem 1fr;
    }
  }
</style>
