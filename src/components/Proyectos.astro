---
import Card from './Card.astro';
import { featured, projects, clients } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang).projects;
---

<section class="my-8 px-4 sm:px-6 lg:px-8" aria-labelledby="proyectos-titulo">
  <h2
    id="proyectos-titulo"
    class="flex items-center my-6 gap-x-3 font-titulo font-extrabold dark:text-white text-3xl sm:text-4xl lg:text-5xl"
  >
    <svg
      class="size-7"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M7 8l-4 4l4 4"></path><path d="M17 8l4 4l-4 4"></path><path
        d="M14 4l-4 16"></path></svg
    >{p.title}
  </h2>

  <div
    id="proyectos"
    class="mx-auto w-full max-w-5xl flex flex-col gap-8 sm:gap-10 lg:gap-12 items-stretch"
  >
    <Card
      project={featured}
      lang={lang}
      tag="personal"
      demoLabel="tryDemo"
      class="project-reveal"
      style="--card-i: 0"
    />
    {
      projects.map((project, i) => (
        <Card
          project={project}
          lang={lang}
          tag="personal"
          class="project-reveal"
          style={`--card-i: ${i + 1}`}
        />
      ))
    }
  </div>

  <div id="clientes" class="mx-auto w-full max-w-5xl mt-14">
    <h3
      class="font-titulo font-extrabold dark:text-white text-2xl sm:text-3xl lg:text-4xl"
    >
      {p.clientsTitle}
    </h3>
    <p class="mt-2 mb-8 text-lg sm:text-xl dark:text-gray-300">
      {p.clientsIntro}
    </p>
    <div class="flex flex-col gap-8 sm:gap-10 lg:gap-12 items-stretch">
      {
        clients.map((client, i) => (
          <Card
            project={client}
            lang={lang}
            tag="client"
            demoLabel="visit"
            class="project-reveal"
            style={`--card-i: ${i}`}
          />
        ))
      }
    </div>
  </div>
</section>
