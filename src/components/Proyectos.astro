---
import Card from './Card.astro';
import { featured, projects, clients } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang).projects;
---

<section id="proyectos" class="wrap section" aria-labelledby="proyectos-titulo">
  <h2 id="proyectos-titulo" class="section-title">{p.title}</h2>

  <div class="list">
    <Card project={featured} lang={lang} featured />

    <div class="pair">
      {projects.map((project) => <Card project={project} lang={lang} />)}
    </div>
  </div>

  <div class="clients">
    <h3 class="clients-title">{p.clientsTitle}</h3>
    <p class="muted">{p.clientsIntro}</p>
    <ul class="client-list">
      {
        clients.map((c) => {
          const text = p.items[c.id as keyof typeof p.items];
          return (
            <li class="client">
              <div>
                <p class="client-name">{c.title}</p>
                <p class="muted">{text.description}</p>
              </div>
              <p class="client-links">
                {c.demo && (
                  <a href={c.demo} target="_blank" rel="noopener noreferrer" class="link">
                    {p.visit}
                    <span class="sr-only"> {c.title}</span>
                  </a>
                )}
                {c.github && (
                  <a href={c.github} target="_blank" rel="noopener noreferrer" class="link">
                    {p.code}
                    <span class="sr-only"> {c.title}</span>
                  </a>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
    margin-top: 2.5rem;
  }
  .pair {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 48rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .clients {
    margin-top: clamp(4rem, 8vw, 6rem);
    max-width: 48rem;
  }
  .clients-title {
    font-size: var(--fs-title);
    font-weight: 700;
    font-variation-settings: 'wdth' 62;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .client-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .client {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .client {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
  .client-name {
    font-weight: 600;
  }
  .client-links {
    display: flex;
    gap: 1.25rem;
    font-weight: 600;
    font-size: 1rem;
  }
</style>
