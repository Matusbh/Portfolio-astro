---
import { t, type Lang } from '../i18n/ui';
import { privacyPath } from '../i18n/privacy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).contact;
const f = c.form;
const email = 'matusbehun03@gmail.com';
const whatsapp = `https://wa.me/34629308162?text=${encodeURIComponent(c.whatsappMessage)}`;
---

<section id="contacto" class="wrap section" aria-labelledby="contacto-titulo">
  <div class="section-grid">
    <h2 id="contacto-titulo" class="section-title">{c.title}</h2>

    <div>
      <p class="intro">{c.intro}</p>
      <a href={`mailto:${email}`} class="email">{email}</a>

      <p class="channels">
        <button type="button" id="copy-email" class="btn btn-ghost">{c.copy}</button>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="link">{c.whatsapp}</a>
        <a
          href="https://www.linkedin.com/in/matus-behun-0790a3370/"
          target="_blank"
          rel="noopener noreferrer"
          class="link">LinkedIn</a
        >
      </p>

      <form id="contact-form" class="form" novalidate>
        <h3 class="form-title">{f.title}</h3>
        <div class="row">
          <div class="field">
            <label for="cf-name">{f.name}</label>
            <input id="cf-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">{f.email}</label>
            <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" />
          </div>
        </div>
        <div class="field">
          <label for="cf-type">{f.type}</label>
          <select id="cf-type" name="type" required>
            <option value="job" selected>{f.types.job}</option>
            <option value="web">{f.types.web}</option>
            <option value="other">{f.types.other}</option>
          </select>
        </div>
        <div class="field">
          <label for="cf-message">{f.message}</label>
          <textarea id="cf-message" name="message" required minlength="10" maxlength="2000" rows="5"></textarea>
        </div>
        <!-- Honeypot: oculto para personas; los bots lo rellenan -->
        <div aria-hidden="true" hidden>
          <input id="cf-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="privacy">
          {f.privacy}<a href={privacyPath(lang)} class="link">{f.privacyLink}</a>.
        </p>
        <div class="submit">
          <button type="submit" class="btn btn-solid">{f.send}</button>
          <p id="cf-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 36rem;
  }
  .email {
    display: inline-block;
    margin-top: 1rem;
    font-size: clamp(1.75rem, 5.5vw, 3.5rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 62;
    line-height: 1.05;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--line);
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  .email:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .form {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .form-title {
    font-size: var(--fs-h3);
    font-weight: 500;
  }
  .row {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: grid;
    gap: 0.375rem;
  }
  label {
    font-size: 1rem;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--raise);
    color: var(--ink);
    font: inherit;
    transition: border-color 150ms ease;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--muted);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: #ff9b8a;
  }
  .privacy {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  #cf-status {
    font-weight: 600;
  }
  #cf-status.ok {
    color: #9be3b5;
  }
  #cf-status.err {
    color: #ff9b8a;
  }
</style>

<script is:inline define:vars={{ email, copyLabels: { copy: c.copy, copied: c.copied } }}>
  const copyBtn = document.getElementById('copy-email');
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = copyLabels.copied;
      setTimeout(() => (copyBtn.textContent = copyLabels.copy), 2000);
    } catch {}
  });
</script>

<script is:inline define:vars={{ msgs: { sending: f.sending, ok: f.ok, error: f.error, invalid: f.invalid, send: f.send } }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('cf-status');
  const button = form.querySelector('button[type="submit"]');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    status.className = '';
    if (!form.checkValidity()) {
      form.reportValidity();
      status.textContent = msgs.invalid;
      status.className = 'err';
      return;
    }
    button.disabled = true;
    button.textContent = msgs.sending;
    try {
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = msgs.ok;
      status.className = 'ok';
    } catch {
      status.textContent = msgs.error;
      status.className = 'err';
    } finally {
      button.disabled = false;
      button.textContent = msgs.send;
    }
  });
</script>
