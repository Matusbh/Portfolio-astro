---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Proyectos from './Proyectos.astro';
import AcercaDeMi from './AcercaDeMi.astro';
import StackTecnico from './StackTecnico.astro';
import Servicios from './Servicios.astro';
import Contacto from './Contacto.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main id="contenido">
    <Hero lang={lang} />
    <Proyectos lang={lang} />
    <AcercaDeMi lang={lang} />
    <StackTecnico lang={lang} />
    <Servicios lang={lang} />
    <Contacto lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
