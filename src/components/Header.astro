---
import { languages, homePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const links = [
  { href: '#proyectos', label: dict.nav.projects },
  { href: '#sobre-mi', label: dict.nav.about },
  { href: '#stack', label: dict.nav.stack },
  { href: '#contacto', label: dict.nav.contact },
];
---

<header class="wrap header">
  <nav aria-label={dict.nav.label}>
    <ul class="nav">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ul class="langs" aria-label={dict.nav.langLabel}>
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <li>
          <a
            href={homePath(l)}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'true' : undefined}
            class="nav-link"
          >
            {languages[l]}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    font-size: 1rem;
  }
  .nav,
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .nav-link {
    color: var(--muted);
    transition: color 150ms ease;
  }
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--ink);
  }
</style>
