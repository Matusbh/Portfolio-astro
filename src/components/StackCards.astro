---
const { title, description } = Astro.props;
---

<div class="stack-item flex justify-center text-center mt-2.5">
  <div
    class="stack-card flex items-center justify-start gap-4 bg-white/20 border border-white/20 rounded-2xl overflow-hidden shadow-md w-[300px] mx-2 px-4 py-2 cursor-default dark:text-white"
  >
    <div class="icon-slot w-12 h-8 flex items-center justify-center shrink-0">
      <slot name="icon" />
    </div>
    <div class="text-left">
      <h3 class="text-xl font-semibold dark:text-white">{title}</h3>
      <p class="dark:text-white">{description}</p>
    </div>
  </div>
</div>

<style>
  .stack-card {
    transition:
      transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px oklch(0.3 0.1 260 / 0.2);
    }
  }

  /* Fuerza a todos los logos (img y svg) a llenar el contenedor */
  .icon-slot :global(img),
  .icon-slot :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>
