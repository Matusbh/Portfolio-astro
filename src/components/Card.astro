---
import type { Project } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  tag?: 'client' | 'personal';
  demoLabel?: 'demo' | 'tryDemo' | 'visit';
  class?: string;
  style?: string;
}

const { project, lang, tag, demoLabel = 'demo', class: className, style } = Astro.props;
const p = t(lang).projects;
const text = p.items[project.id as keyof typeof p.items];

const tagStyles = {
  client: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-300',
  personal: 'bg-blue-100 text-blue-900 dark:bg-blue-900/40 dark:text-blue-300',
};
const tagLabel = tag === 'client' ? p.tagClient : p.tagPersonal;
const btn =
  'btn-card bg-[#1b3669] px-5 py-3 rounded-lg font-texto text-white dark:bg-[#4f82e2] dark:text-[#0d0d18] font-semibold';
---

<article
  class={`project-card group flex flex-col sm:flex-row gap-2.5 ${className || ''}`}
  style={style}
  aria-labelledby={`proy-${project.id}`}
>
  <div class="shrink-0">
    <img
      src={project.image}
      alt={project.title}
      width="560"
      height="320"
      loading="lazy"
      decoding="async"
      class="w-full sm:w-[560px] h-[220px] sm:h-[320px] object-cover rounded-2xl"
    />
  </div>

  <div class="p-4 text-center sm:text-left">
    <div class="flex items-center gap-2 flex-wrap justify-center sm:justify-start">
      <h3 id={`proy-${project.id}`} class="text-3xl sm:text-4xl font-titulo font-extrabold dark:text-[#4f82e2]">
        {project.title}
      </h3>
      {tag && (
        <span class={`text-sm font-semibold px-3 py-1 rounded-full ${tagStyles[tag]}`}>
          {tagLabel}
        </span>
      )}
    </div>
    <p class="mt-3 max-w-[600px] text-lg sm:text-xl dark:text-white">{text.description}</p>
    {text.metric && (
      <p class="mt-2 text-base font-semibold text-[#1b3669] dark:text-[#4f82e2]">{text.metric}</p>
    )}

    <ul
      class="flex flex-wrap gap-2 mt-3 justify-center sm:justify-start"
      aria-label={p.stackLabel}
    >
      {project.stack.map((s) => (
        <li class="text-sm px-2.5 py-1 rounded-full bg-[#1b3669]/10 text-[#1b3669] dark:bg-white/10 dark:text-gray-200">
          {s}
        </li>
      ))}
    </ul>

    <div class="flex gap-2 mt-4 justify-center sm:justify-start flex-wrap">
      {project.demo && (
        <a href={project.demo} target="_blank" rel="noopener noreferrer" class={btn}>
          {p[demoLabel]}
        </a>
      )}
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer" class={btn}>
          {p.github}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-4px);
    }
  }

  .btn-card {
    transition:
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-card:hover {
      transform: translateY(-1px);
    }
  }

  .btn-card:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }
</style>
