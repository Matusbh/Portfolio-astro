---
import type { Project } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const p = t(lang).projects;
const text = p.items[project.id as keyof typeof p.items];
const demoLabel = featured ? p.tryDemo : p.demo;
---

<article class:list={['project', { featured }]} aria-labelledby={`proy-${project.id}`}>
  <div class="media">
    {
      project.video ? (
        <video
          src={project.video}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={project.title}
          width="1200"
          height="750"
        />
      ) : (
        <img
          src={project.image}
          alt=""
          width="1200"
          height="750"
          loading={featured ? 'eager' : 'lazy'}
          decoding="async"
        />
      )
    }
  </div>

  <div class="body">
    <h3 id={`proy-${project.id}`} class="title">{project.title}</h3>
    <p class="desc">{text.description}</p>
    {text.metric && <p class="metric">{text.metric}</p>}
    <p class="stack">
      <span class="sr-only">{p.stackLabel}: </span>{project.stack.join(', ')}
    </p>
    {
      (project.demo || project.github) && (
        <p class="links">
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noopener noreferrer" class="link">
              {demoLabel}
            </a>
          )}
          {project.github && (
            <a href={project.github} target="_blank" rel="noopener noreferrer" class="link">
              {p.code}
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--raise);
  }
  .media img,
  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* El vídeo de MyMoney puede ser vertical: se muestra entero */
  .media video {
    object-fit: contain;
  }

  .title {
    font-size: var(--fs-title);
    font-weight: 700;
    font-variation-settings: 'wdth' 62;
    line-height: 1;
  }
  .featured .title {
    font-size: clamp(2.25rem, 5vw, 3rem);
  }

  .desc {
    margin-top: 0.75rem;
    max-width: 38rem;
  }
  .metric {
    margin-top: 0.75rem;
    color: var(--ink);
    font-weight: 600;
  }
  .stack {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1rem;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    font-weight: 600;
  }

  @media (min-width: 56rem) {
    .featured {
      grid-template-columns: 1.6fr 1fr;
      gap: 2.5rem;
      align-items: end;
    }
  }
</style>
