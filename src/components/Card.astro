---
const {
  title,
  description,
  image,
  github,
  demo,
  tag,
  underConstruction = false,
  class: className,
} = Astro.props;

const tagStyles: Record<string, string> = {
  'Cliente real':
    'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
  Personal: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
};
const tagClass = tag ? (tagStyles[tag] ?? 'bg-gray-100 text-gray-700') : '';
---

<div
  class={`project-card group flex flex-col sm:flex-row gap-2.5 ${className || ''}`}
>
  <div class="relative">
    <a href={demo}>
      <img
        src={image}
        alt={title}
        class="w-full sm:w-[460px] h-[220px] sm:h-[260px] object-cover rounded-2xl transition-transform duration-500 ease-out hover:scale-105"
      />
    </a>

    {
      underConstruction && (
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100
            bg-black/60 flex items-center justify-center
            text-white text-2xl font-bold rounded-2xl backdrop-blur-sm
            transition-opacity duration-300"
        >
          En construcción
        </div>
      )
    }
  </div>

  <div class="p-4">
    <div
      class="flex items-center gap-2 flex-wrap justify-center sm:justify-start"
    >
      <h3 class="text-4xl font-titulo font-extrabold dark:text-[#4f82e2]">
        {title}
      </h3>
      {
        tag && (
          <span
            class={`text-md font-semibold px-3 py-1 rounded-full ${tagClass}`}
          >
            {tag}
          </span>
        )
      }
    </div>
    <p class="text-2xl mt-2 max-w-[600px] dark:text-white">{description}</p>

    <div class="flex gap-2 mt-4 justify-center sm:justify-start">
      {
        github && (
          <a
            href={github}
            target="_blank"
            class="bg-[#1b3669] px-5 py-3 rounded-lg font-texto text-m text-white dark:text-white dark:bg-[#4f82e2] btn-card"
          >
            GitHub
          </a>
        )
      }
      {
        demo && !underConstruction && (
          <a
            href={demo}
            target="_blank"
            class="bg-[#1b3669] px-5 py-3 rounded-lg font-texto text-m text-white dark:bg-[#4f82e2] btn-card"
          >
            Demo
          </a>
        )
      }
      {
        underConstruction && (
          <span class="bg-gray-600 px-5 py-3 rounded-lg font-texto text-m text-white opacity-80 cursor-not-allowed">
            Próximamente
          </span>
        )
      }
    </div>
  </div>
</div>

<style>
  .project-card {
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-4px);
    }
  }

  .btn-card {
    transition:
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-card:hover {
      transform: translateY(-1px);
    }
  }

  .btn-card:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }
</style>
