---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).services;
---

<section id="webs" class="wrap section" aria-labelledby="webs-titulo">
  <div class="section-grid">
    <h2 id="webs-titulo" class="section-title">{s.title}</h2>

    <div class="content">
      <p>{s.intro}</p>
      <ul>
        {s.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .content {
    max-width: 38rem;
  }
  ul {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--muted);
  }
  li + li {
    margin-top: 0.5rem;
  }
  li::marker {
    color: var(--line);
  }
</style>
