---
import Layout from '../layouts/Layout.astro';
import Minicards from './StackCards.astro';
---

<Layout>
  <div id="Stack">
    <h2
      class="my-8 px-4 flex items-center justify-around sm:my-6 text-5xl font-titulo font-extrabold gap-x-3 dark:text-white"
    >
      Stack técnico
    </h2>
  </div>

  <div
    id="tarjetas-big"
    class="my-8 mx-5 px-4 flex flex-col items-center gap-5 sm:px-6 sm:flex sm:flex-row sm:items-stretch sm:justify-around sm:text-center lg:px-8 flex-wrap"
  >
    <!-- Lenguajes -->
    <div
      id="primera"
      class="reveal-item reveal-left flex-col justify-center border border-white/20 rounded-2xl overflow-hidden shadow-md w-[300px] h-auto px-3 py-4 bg-white/20 backdrop-blur-md big-card"
    >
      <h3 class="text-2xl text-center font-semibold dark:text-white mb-[15px]">
        Lenguajes
      </h3>
      <div>
        <Minicards title="JavaScript" description="" style="--stack-i: 0">
          <img slot="icon" src="/JavaScript.svg" alt="Logo de JavaScript" />
        </Minicards>

        <Minicards title="TypeScript" description="" style="--stack-i: 1">
          <img slot="icon" src="/typescript.svg" alt="Logo de TypeScript" />
        </Minicards>

        <Minicards title="Python" description="" style="--stack-i: 2">
          <img slot="icon" src="/py-logo.svg" alt="Logo de Python" />
        </Minicards>
      </div>
    </div>

    <!-- Herramientas y Frameworks -->
    <div
      id="segunda"
      class="reveal-item reveal-right flex-col justify-center border border-white/20 rounded-2xl overflow-hidden shadow-md w-[300px] h-auto px-3 py-4 bg-white/20 backdrop-blur-md big-card"
    >
      <h3 class="text-2xl text-center font-semibold dark:text-white mb-[15px]">
        Herramientas y Frameworks
      </h3>
      <div>
        <Minicards title="Astro" description="" style="--stack-i: 0">
          <img slot="icon" src="/Astro.svg" alt="Logo de Astro" />
        </Minicards>

        <Minicards title="ReactJS" description="" style="--stack-i: 1">
          <img slot="icon" src="/react.svg" alt="Logo de React" />
        </Minicards>

        <Minicards title="Tailwind" description="" style="--stack-i: 3">
          <img slot="icon" src="/tailwind.svg" alt="Logo de Tailwind" />
        </Minicards>

        <Minicards title="Git" description="" style="--stack-i: 4">
          <img slot="icon" src="/Git.svg" alt="Logo de Git" />
        </Minicards>
      </div>
    </div>

    <!-- Automatizaciones e IA -->
    <div
      id="tercera"
      class="reveal-item reveal-left flex-col justify-center border border-white/20 rounded-2xl overflow-hidden shadow-md w-[300px] h-auto px-3 py-4 bg-white/20 backdrop-blur-md big-card"
    >
      <h3 class="text-2xl text-center font-semibold dark:text-white mb-[15px]">
        Automatizaciones e IA
      </h3>
      <div>
        <Minicards title="N8N" description="" style="--stack-i: 0">
          <img slot="icon" src="/n8n.svg" alt="Logo de N8N" />
        </Minicards>

        <Minicards title="Cursor" description="" style="--stack-i: 0">
          <img slot="icon" src="/cursor.svg" alt="Logo de Cursor" />
        </Minicards>

        <Minicards title="OpenAI API" description="" style="--stack-i: 3">
          <img slot="icon" src="/openai.svg" alt="Logo de OpenAI" />
        </Minicards>

        <Minicards title="Claude Code" description="" style="--stack-i: 1">
          <img slot="icon" src="/claude-code.svg" alt="Logo de Claude Code" />
        </Minicards>
      </div>
    </div>
  </div>
</Layout>

<style>
  .big-card {
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .big-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px oklch(0.3 0.1 260 / 0.25);
    }
  }
</style>
