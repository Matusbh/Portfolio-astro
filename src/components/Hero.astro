---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang).hero;
const cvEs = '/CV_Matus_Behun_ES.pdf';
const cvEn = '/CV_Matus_Behun_EN_2.pdf';
// Primero el CV en el idioma de la página
const [cvPrimary, cvSecondary] = lang === 'es' ? [cvEs, cvEn] : [cvEn, cvEs];
---

<section class="wrap hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="name">Matus Behun</h1>

  <div class="hero-body">
    <div class="hero-text">
      <p class="lead">{h.lead}</p>
      <p class="status">{h.status}</p>
    </div>

    <div class="hero-actions">
      <a href={cvPrimary} download class="btn btn-solid">{h.cvPrimary}</a>
      <a href={cvSecondary} download class="btn btn-ghost">{h.cvSecondary}</a>
      <p class="profiles">
        <a href="https://github.com/Matusbh" target="_blank" rel="noopener noreferrer" class="link">GitHub</a>
        <a
          href="https://www.linkedin.com/in/matus-behun-0790a3370/"
          target="_blank"
          rel="noopener noreferrer"
          class="link">LinkedIn</a
        >
        <a href="mailto:matusbehun03@gmail.com" class="link">matusbehun03@gmail.com</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2rem, 8vw, 6rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  /* La pieza protagonista: el nombre ultracondensado, a todo el ancho */
  .name {
    /* Calibrado para que "Matus Behun" ocupe todo el ancho del contenedor */
    font-size: clamp(3.5rem, 21vw, 15.5rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 62;
    line-height: 0.82;
    letter-spacing: -0.015em;
    margin-left: -0.04em;
    white-space: nowrap;
    animation: ink-in 1100ms var(--ease-out) both;
  }

  @keyframes ink-in {
    from {
      font-weight: 100;
    }
    to {
      font-weight: 800;
    }
  }

  .hero-body {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 56rem) {
    .hero-body {
      grid-template-columns: minmax(0, 38rem) auto;
      justify-content: space-between;
      align-items: end;
    }
  }

  .lead {
    font-size: var(--fs-h3);
    line-height: 1.45;
  }
  .status {
    margin-top: 1rem;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-content: start;
  }
  @media (min-width: 56rem) {
    .hero-actions {
      justify-content: flex-end;
      max-width: 24rem;
    }
  }
  .profiles {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: 1rem;
  }
  @media (min-width: 56rem) {
    .profiles {
      justify-content: flex-end;
    }
  }
</style>
