---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const l = t(lang).languages;
---

<section aria-labelledby="idiomas-titulo">
  <h2
    id="idiomas-titulo"
    class="my-8 px-4 flex items-center justify-around sm:my-6 text-5xl font-titulo font-extrabold gap-x-3 dark:text-white"
  >
    {l.title}
  </h2>

  <div
    id="tarjetas-idiomas"
    class="my-8 mx-5 px-4 flex flex-col items-center gap-5 sm:px-6 sm:flex sm:flex-row sm:items-stretch sm:justify-around sm:text-center lg:px-8"
  >
    <div
      id="idiomas-card"
      class="flex-col w-full justify-center border border-[#1b3669]/20 dark:border-white/20 rounded-2xl overflow-hidden shadow-md h-auto px-3 py-4 bg-white/20 backdrop-blur-md"
    >
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          l.items.map((item, i) => (
            <li
              class={`reveal-item ${i % 2 === 0 ? 'reveal-left' : 'reveal-right'} flex items-center gap-3 px-4 py-4 rounded-xl bg-white/40 dark:bg-white/10 shadow-md`}
            >
              <img
                src={`https://flagicons.lipis.dev/flags/4x3/${item.flag}.svg`}
                alt={`${l.flagAlt} ${item.country}`}
                width="40"
                height="32"
                loading="lazy"
                class="w-10 h-8 object-cover rounded-sm"
              />
              <div class="flex flex-col text-left">
                <span class="text-[#1b3669] dark:text-white font-semibold text-xl">{item.name}</span>
                <span class="text-gray-700 dark:text-white/70 text-lg">{item.level}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="text-gray-700 dark:text-white/70 text-xl text-center mt-4 px-2">{l.note}</p>
    </div>
  </div>
</section>
