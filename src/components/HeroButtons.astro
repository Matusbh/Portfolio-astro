---
const { ref, download = false } = Astro.props;
---

<a
  href={ref}
  download={download}
  class="btn-hero inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 bg-[#7BBDE8] border border-[#7BBDE8] rounded-full dark:bg-gray-800 dark:border-gray-600 dark:text-white text-md hover:bg-gray-900 hover:border-gray-700 hover:text-white dark:hover:bg-gray-100 dark:hover:border-gray-300 dark:hover:text-black group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 cursor-pointer my-2.5"
>
  <slot name="before" />
  <slot />
  <slot name="after" />
</a>

<style>
  .btn-hero {
    transition:
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero:hover {
      transform: translateY(-1px);
    }
  }

  .btn-hero:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }
</style>
