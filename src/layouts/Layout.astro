---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>MatDevs</title>

    <!-- Fuentes de google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=Shanti&family=Smythe&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/MatDevs.png" />
  </head>
  <body class="w-full sm:max-w-[1200px] sm:mx-auto">
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  // Evita que el navegador restaure el scroll y limpia hashes previos
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (location.hash) {
    history.replaceState(null, '', location.pathname + location.search);
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  // Section reveal (horizontal) — una sola vez
  const revealItems = document.querySelectorAll('.reveal-item');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );
  revealItems.forEach((item) => revealObserver.observe(item));

  // Project cards reveal — vertical con stagger via CSS --card-i
  const projectCards = document.querySelectorAll('.project-reveal');
  const projectObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('project-visible');
          projectObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  projectCards.forEach((card) => projectObserver.observe(card));

  // Stack items reveal — scale con stagger via CSS --stack-i
  const stackContainers = document.querySelectorAll('#tarjetas-big > div');
  const stackObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.stack-item').forEach((item) => {
            item.classList.add('stack-visible');
          });
          stackObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  stackContainers.forEach((container) => stackObserver.observe(container));
</script>

<style is:global>
  :root {
    background: #f1f1fd;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      background: #0d0d18;
    }
  }
</style>
