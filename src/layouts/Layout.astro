---
import '../styles/global.css';
import { languages, homePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta de esta página en cada idioma. Por defecto, la home. */
  alternates?: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const dict = t(lang);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const pathFor = (l: Lang) => (alternates ? alternates[l] : homePath(l));
const site = Astro.site ?? new URL('https://matdevs.com');
const canonical = new URL(pathFor(lang), site).href;
const ogImage = new URL('/Foto-Matus-1.webp', site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: 'Matus Behun',
      jobTitle: 'Full Stack Developer',
      url: site.origin,
      image: ogImage,
      email: 'mailto:matusbehun03@gmail.com',
      sameAs: [
        'https://github.com/Matusbh',
        'https://www.linkedin.com/in/matus-behun-0790a3370/',
      ],
      knowsLanguage: ['es', 'sk', 'en', 'cs'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.origin}/#service`,
      name: 'MatDevs',
      url: site.origin,
      founder: { '@id': `${site.origin}/#person` },
      areaServed: { '@type': 'AdministrativeArea', name: 'Tenerife' },
      serviceType: ['Web development', 'Automation with n8n', 'Website maintenance'],
      telephone: '+34629308162',
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      Object.keys(languages).map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(pathFor(l as Lang), site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathFor('es'), site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MatDevs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={dict.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/MatDevs.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#000000" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">{dict.footer.skip}</a>
    <slot />
  </body>
</html>
